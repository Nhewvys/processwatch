[Unit]
Description=ProcessWatch API and collection worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=processwatch
Group=processwatch
WorkingDirectory=/opt/processwatch
EnvironmentFile=/etc/processwatch/processwatch.env
UMask=0077
ExecStart=/opt/processwatch/.venv/bin/processwatch web --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/processwatch
ReadOnlyPaths=/etc/processwatch/processwatch.env
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
