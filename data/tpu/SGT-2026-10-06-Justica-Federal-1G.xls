								  <font style='color:#800000;'>Regressão de Regime</font> 
							  </td><td> </td><td> </td><td  align=left nowrap
									style='font-family:Verdana,sans-serif;font-size: 8pt;font-weight:300;' >1014</td><td  align=left nowrap
