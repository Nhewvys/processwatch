# Copie para .env no diretório de onde o processo será iniciado.
# Variáveis já definidas no ambiente têm precedência sobre este arquivo.
# Use contas para usuários; o token legado é apenas para o modo token e a extensão local.
DATAJUD_API_KEY=
PROCESSWATCH_ACCESS_TOKEN=
PROCESSWATCH_AUTH_MODE=token
# Em accounts, crie o primeiro administrador com scripts/create_admin.py.
PROCESSWATCH_SESSION_DAYS=14
PROCESSWATCH_SESSION_IDLE_MINUTES=60
PROCESSWATCH_SESSION_COOKIE_SECURE=0
PROCESSWATCH_ENV=development
# production exige PUBLIC_ORIGIN HTTPS e SESSION_COOKIE_SECURE=1.
PROCESSWATCH_PUBLIC_ORIGIN=
DJEN_INITIAL_DATE=2024-10-01
DJEN_WINDOW_DAYS=90
DJEN_OVERLAP_DAYS=7
DJEN_SYNC_INTERVAL=86400
DJEN_AUTO_SYNC=0

DJEN_MIN_INTERVAL=1
PROCESSWATCH_DB=processwatch.dev.sqlite3
PROCESSWATCH_PRIMARY_DB=processwatch.sqlite3
DATAJUD_TIMEOUT=90
DATAJUD_ATTEMPTS=3
DATAJUD_MIN_INTERVAL=2
DATAJUD_MAX_BACKOFF=60
PROCESSWATCH_INTERVAL=86400
PROCESSWATCH_MAX_PROCESSES=100
PROCESSWATCH_JOB_MAX_ATTEMPTS=5
PROCESSWATCH_JOB_LEASE_SECONDS=1800
PROCESSWATCH_JOB_RETRY_BASE_SECONDS=5
PROCESSWATCH_JOB_RETRY_MAX_SECONDS=900
PROCESSWATCH_COURT_RETRY_BASE_SECONDS=30
PROCESSWATCH_COURT_RETRY_MAX_SECONDS=3600
